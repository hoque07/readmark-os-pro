APP_NAME=ReadMark OS API
ENVIRONMENT=development
API_PREFIX=/api
SECRET_KEY=change-this-to-a-long-random-secret-before-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SQLite works instantly for local development.
DATABASE_URL=sqlite:///./data/readmark.db

# Local frontend origins. Add your deployed frontend URL later.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The first owner account is created automatically on first startup.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Tanvir
SEED_DEMO_DATA=true

# Optional AI configuration. The app still works without these values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=
AI_FALLBACK_ON_ERROR=true

# Upload settings
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Set true only when deploying a single combined frontend/backend build.
SERVE_FRONTEND=false
FRONTEND_DIST=../frontend/dist
